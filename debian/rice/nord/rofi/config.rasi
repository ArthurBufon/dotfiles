configuration {
    modi: "drun,run,window";
    show-icons: true;
    display-drun: "Aplicativos";
    display-run: "Comandos";
    display-window: "Janelas";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 11";
    matching: "fuzzy";
}

* {
    nord0: #2e3440;
    nord1: #3b4252;
    nord2: #434c5e;
    nord3: #4c566a;
    nord4: #d8dee9;
    nord6: #eceff4;
    nord8: #88c0d0;
    nord9: #81a1c1;

    background-color: transparent;
    text-color: @nord4;
}

window {
    width: 640px;
    border: 2px;
    border-color: @nord8;
    border-radius: 14px;
    background-color: @nord0;
    padding: 18px;
}

mainbox {
    spacing: 14px;
}

inputbar {
    padding: 12px 14px;
    border-radius: 10px;
    background-color: @nord1;
    children: [ prompt, entry ];
}

prompt {
    text-color: @nord8;
    padding: 0 10px 0 0;
}

entry {
    placeholder: "Buscar aplicativo...";
    placeholder-color: @nord3;
    text-color: @nord6;
}

listview {
    lines: 7;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 6px;
}

element {
    padding: 10px 12px;
    border-radius: 9px;
    spacing: 12px;
}

element normal.normal {
    background-color: transparent;
    text-color: @nord4;
}

element selected.normal {
    background-color: @nord2;
    text-color: @nord6;
}

element-icon {
    size: 28px;
}

element-text {
    vertical-align: 0.5;
}

message {
    padding: 10px;
    border-radius: 9px;
    background-color: @nord1;
}
